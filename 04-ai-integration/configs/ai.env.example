# Repository-safe example only. Never commit the real OpenAI or HEC token.
OPENAI_API_KEY=REPLACE_WITH_PROJECT_SERVICE_ACCOUNT_KEY
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=30

SPLUNK_HEC_TOKEN=REPLACE_WITH_DEDICATED_HEC_TOKEN
SPLUNK_HEC_URL=https://dns-soc-splunk:8088/services/collector/event
SPLUNK_HEC_TIMEOUT_SECONDS=10

# Current lab setting: encrypted HEC traffic with the internal/self-signed
# certificate not verified by the bridge. See 01-architecture-and-security.md.
SPLUNK_HEC_VERIFY_TLS=false

LOG_LEVEL=INFO
